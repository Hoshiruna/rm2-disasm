# PRG bank $0D, mapped at $8000.
# CODE ranges cover the title and stage-select instructions in the phase-4 traces.

GLOBAL { CPU "6502"; STARTADDR $8000; INPUTOFFS $34010; INPUTSIZE $4000; LABELBREAK 0; COMMENTS 3; };
SEGMENT { START $8000; END $BFFF; NAME "PRG_BANK_0D"; };

RANGE { START $8000; END $8002; TYPE Code; };
RANGE { START $8003; END $8008; TYPE ByteTable; };
RANGE { START $8009; END $800B; TYPE Code; };
RANGE { START $800C; END $8014; TYPE ByteTable; };
RANGE { START $8015; END $802C; TYPE Code; };
RANGE { START $802D; END $80AA; TYPE ByteTable; };
RANGE { START $80AB; END $80CB; TYPE Code; };
RANGE { START $80CC; END $80D8; TYPE ByteTable; };
RANGE { START $80D9; END $80E9; TYPE Code; };
RANGE { START $80EA; END $82AA; TYPE ByteTable; };
RANGE { START $82AB; END $82C9; TYPE Code; };
RANGE { START $82CA; END $8311; TYPE ByteTable; UNIT 8; };
RANGE { START $8312; END $865E; TYPE ByteTable; };
RANGE { START $865F; END $8667; TYPE ByteTable; };
RANGE { START $8668; END $9EE6; TYPE ByteTable; };
RANGE { START $9EE7; END $9EFC; TYPE Code; };
RANGE { START $9EFD; END $BFFF; TYPE ByteTable; };

LABEL { ADDR $2000; NAME "PPUCTRL"; };
LABEL { ADDR $2001; NAME "PPUMASK"; };
