# PRG bank $0B at $8000. Code and data ranges are unclassified.

GLOBAL {
    CPU "6502";
    STARTADDR $8000;
    INPUTOFFS $2C010;
    INPUTSIZE $4000;
    LABELBREAK 0;
    COMMENTS 3;
};

SEGMENT { START $8000; END $BFFF; NAME "PRG_BANK_0B"; };

RANGE { START $8000; END $BFFF; TYPE ByteTable; };
